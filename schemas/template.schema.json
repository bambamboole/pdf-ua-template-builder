{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdf-ua-api.com/schemas/template-v1.json",
  "title": "Template",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "config": {
      "$ref": "#/$defs/templateConfig"
    },
    "fonts": {
      "type": "object",
      "description": "External fonts keyed by font family name.",
      "additionalProperties": {
        "$ref": "#/$defs/fontFace"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileAttachment"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "additionalProperties": false,
  "required": ["version"],
  "$defs": {
    "align": {
      "type": "string",
      "title": "Align",
      "enum": ["left", "center", "right"]
    },
    "pageFormat": {
      "type": "string",
      "title": "PageFormat",
      "enum": ["A3", "A4", "A5", "A6", "Letter", "Legal", "Tabloid"]
    },
    "orientation": {
      "type": "string",
      "title": "Orientation",
      "enum": ["portrait", "landscape"]
    },
    "dividerStyle": {
      "type": "string",
      "title": "DividerStyle",
      "enum": ["solid", "dashed", "dotted", "double", "none"]
    },
    "pageBackgroundType": {
      "type": "string",
      "title": "PageBackgroundType",
      "enum": ["auto", "image", "pdf"]
    },
    "typographyConfig": {
      "type": "object",
      "title": "TypographyConfig",
      "properties": {
        "family": {
          "type": ["string", "null"],
          "description": "Bundled or external font family key."
        },
        "size": {
          "type": ["integer", "null"],
          "description": "Font size in points.",
          "minimum": 1
        },
        "weight": {
          "type": ["integer", "null"],
          "description": "Numeric font weight."
        },
        "align": {
          "type": ["string", "null"],
          "description": "Text alignment for this typography scope.",
          "enum": ["left", "center", "right", null]
        },
        "color": {
          "type": ["string", "null"],
          "description": "CSS color value used for text."
        }
      },
      "additionalProperties": false
    },
    "spacingConfig": {
      "type": "object",
      "title": "SpacingConfig",
      "properties": {
        "top": {
          "type": ["integer", "null"],
          "description": "Top spacing in millimetres.",
          "minimum": 0
        },
        "right": {
          "type": ["integer", "null"],
          "description": "Right spacing in millimetres.",
          "minimum": 0
        },
        "bottom": {
          "type": ["integer", "null"],
          "description": "Bottom spacing in millimetres.",
          "minimum": 0
        },
        "left": {
          "type": ["integer", "null"],
          "description": "Left spacing in millimetres.",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "blockConfig": {
      "type": "object",
      "title": "BlockConfig",
      "properties": {
        "typography": {
          "oneOf": [
            {
              "$ref": "#/$defs/typographyConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "spacing": {
          "oneOf": [
            {
              "$ref": "#/$defs/spacingConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "type": ["string", "null"],
          "description": "CSS width for this block, such as 50%, 80mm, or auto."
        },
        "align": {
          "type": ["string", "null"],
          "description": "Horizontal placement of this block within its row cell.",
          "enum": ["left", "center", "right", null]
        }
      },
      "additionalProperties": false,
      "tsType": "{ typography?: TypographyConfig; spacing?: SpacingConfig; width?: string | null; align?: Align | null }"
    },
    "headingConfig": {
      "type": "object",
      "title": "HeadingConfig",
      "properties": {
        "typography": {
          "oneOf": [
            {
              "$ref": "#/$defs/typographyConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "spacing": {
          "oneOf": [
            {
              "$ref": "#/$defs/spacingConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "type": ["string", "null"],
          "description": "CSS width for this block, such as 50%, 80mm, or auto."
        },
        "align": {
          "type": ["string", "null"],
          "description": "Horizontal placement of this block within its row cell.",
          "enum": ["left", "center", "right", null]
        },
        "level": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 6
        }
      },
      "additionalProperties": false,
      "tsType": "BlockConfig & { level?: number }"
    },
    "imageConfig": {
      "type": "object",
      "title": "ImageConfig",
      "properties": {
        "typography": {
          "oneOf": [
            {
              "$ref": "#/$defs/typographyConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "spacing": {
          "oneOf": [
            {
              "$ref": "#/$defs/spacingConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "type": ["string", "null"],
          "description": "CSS width for this block, such as 50%, 80mm, or auto."
        },
        "align": {
          "type": ["string", "null"],
          "description": "Horizontal placement of this block within its row cell.",
          "enum": ["left", "center", "right", null]
        },
        "maxHeight": {
          "type": "integer",
          "default": 60,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "tsType": "BlockConfig & { maxHeight?: number }"
    },
    "spacerConfig": {
      "type": "object",
      "title": "SpacerConfig",
      "properties": {
        "typography": {
          "oneOf": [
            {
              "$ref": "#/$defs/typographyConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "spacing": {
          "oneOf": [
            {
              "$ref": "#/$defs/spacingConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "type": ["string", "null"],
          "description": "CSS width for this block, such as 50%, 80mm, or auto."
        },
        "align": {
          "type": ["string", "null"],
          "description": "Horizontal placement of this block within its row cell.",
          "enum": ["left", "center", "right", null]
        },
        "height": {
          "type": "integer",
          "default": 5,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "tsType": "BlockConfig & { height?: number }"
    },
    "dividerConfig": {
      "type": "object",
      "title": "DividerConfig",
      "properties": {
        "typography": {
          "oneOf": [
            {
              "$ref": "#/$defs/typographyConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "spacing": {
          "oneOf": [
            {
              "$ref": "#/$defs/spacingConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "type": ["string", "null"],
          "description": "CSS width for this block, such as 50%, 80mm, or auto."
        },
        "align": {
          "type": ["string", "null"],
          "description": "Horizontal placement of this block within its row cell.",
          "enum": ["left", "center", "right", null]
        },
        "thickness": {
          "type": "integer",
          "default": 1,
          "minimum": 0
        },
        "lineColor": {
          "type": "string",
          "default": "#d1d5db",
          "pattern": "^#[0-9A-Fa-f]{3,8}$"
        },
        "style": {
          "$ref": "#/$defs/dividerStyle"
        }
      },
      "additionalProperties": false,
      "tsType": "BlockConfig & { thickness?: number; lineColor?: string; style?: DividerStyle }"
    },
    "textBlock": {
      "type": "object",
      "title": "TextBlock",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        },
        "id": {
          "type": ["string", "null"],
          "description": "Stable block identifier used for runtime data overrides."
        },
        "text": {
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/blockConfig"
        }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "htmlBlock": {
      "type": "object",
      "title": "HtmlBlock",
      "properties": {
        "type": {
          "type": "string",
          "const": "html"
        },
        "id": {
          "type": ["string", "null"],
          "description": "Stable block identifier used for runtime data overrides."
        },
        "html": {
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/blockConfig"
        }
      },
      "required": ["type", "html"],
      "additionalProperties": false
    },
    "headingBlock": {
      "type": "object",
      "title": "HeadingBlock",
      "properties": {
        "type": {
          "type": "string",
          "const": "heading"
        },
        "id": {
          "type": ["string", "null"],
          "description": "Stable block identifier used for runtime data overrides."
        },
        "text": {
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/headingConfig"
        }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "imageBlock": {
      "type": "object",
      "title": "ImageBlock",
      "properties": {
        "type": {
          "type": "string",
          "const": "image"
        },
        "id": {
          "type": ["string", "null"],
          "description": "Stable block identifier used for runtime data overrides."
        },
        "src": {
          "type": "string",
          "description": "Public image URL, SVG markup, or uploaded image data URL."
        },
        "alt": {
          "type": "string",
          "description": "Alternative text for screen readers and PDF accessibility.",
          "default": ""
        },
        "config": {
          "$ref": "#/$defs/imageConfig"
        }
      },
      "required": ["type", "src"],
      "additionalProperties": false
    },
    "spacerBlock": {
      "type": "object",
      "title": "SpacerBlock",
      "properties": {
        "type": {
          "type": "string",
          "const": "spacer"
        },
        "id": {
          "type": ["string", "null"],
          "description": "Stable block identifier used for runtime data overrides."
        },
        "config": {
          "$ref": "#/$defs/spacerConfig"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "dividerBlock": {
      "type": "object",
      "title": "DividerBlock",
      "properties": {
        "type": {
          "type": "string",
          "const": "divider"
        },
        "id": {
          "type": ["string", "null"],
          "description": "Stable block identifier used for runtime data overrides."
        },
        "config": {
          "$ref": "#/$defs/dividerConfig"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/textBlock"
        },
        {
          "$ref": "#/$defs/htmlBlock"
        },
        {
          "$ref": "#/$defs/headingBlock"
        },
        {
          "$ref": "#/$defs/imageBlock"
        },
        {
          "$ref": "#/$defs/spacerBlock"
        },
        {
          "$ref": "#/$defs/dividerBlock"
        }
      ]
    },
    "row": {
      "type": "object",
      "title": "Row",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "required": ["blocks"],
      "additionalProperties": false
    },
    "presetPageSize": {
      "type": "object",
      "title": "PresetPageSize",
      "properties": {
        "format": {
          "$ref": "#/$defs/pageFormat"
        },
        "orientation": {
          "$ref": "#/$defs/orientation"
        }
      },
      "additionalProperties": false
    },
    "customPageSize": {
      "type": "object",
      "title": "CustomPageSize",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["width", "height"],
      "additionalProperties": false
    },
    "pageSize": {
      "oneOf": [
        {
          "$ref": "#/$defs/presetPageSize"
        },
        {
          "$ref": "#/$defs/customPageSize"
        }
      ],
      "title": "PageSize"
    },
    "pageNumbersConfig": {
      "type": "object",
      "title": "PageNumbersConfig",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "position": {
          "$ref": "#/$defs/align"
        }
      },
      "additionalProperties": false
    },
    "pageBackgroundConfig": {
      "type": "object",
      "title": "PageBackgroundConfig",
      "properties": {
        "src": {
          "type": "string",
          "description": "HTTP, HTTPS, or base64 data URI for an image or PDF page background.",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/pageBackgroundType"
        }
      },
      "required": ["src"],
      "additionalProperties": false
    },
    "pageConfig": {
      "type": "object",
      "title": "PageConfig",
      "properties": {
        "size": {
          "$ref": "#/$defs/pageSize"
        },
        "locale": {
          "type": "string",
          "default": "de_DE"
        },
        "margins": {
          "$ref": "#/$defs/spacingConfig"
        },
        "pageNumbers": {
          "$ref": "#/$defs/pageNumbersConfig"
        },
        "background": {
          "oneOf": [
            {
              "$ref": "#/$defs/pageBackgroundConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "tsType": "{ size?: PageSize; locale?: string; margins?: SpacingConfig; pageNumbers?: PageNumbersConfig; background?: PageBackgroundConfig | null }"
    },
    "templateConfig": {
      "type": "object",
      "title": "TemplateConfig",
      "properties": {
        "page": {
          "$ref": "#/$defs/pageConfig"
        },
        "typography": {
          "$ref": "#/$defs/typographyConfig"
        }
      },
      "additionalProperties": false,
      "tsType": "{ page?: PageConfig; typography?: TypographyConfig }"
    },
    "fontFace": {
      "type": "object",
      "title": "FontFace",
      "properties": {
        "src": {
          "type": "string"
        },
        "weight": {
          "type": "integer",
          "default": 400
        },
        "style": {
          "type": "string",
          "default": "normal"
        }
      },
      "required": ["src"],
      "additionalProperties": false
    },
    "fileAttachment": {
      "type": "object",
      "title": "FileAttachment",
      "properties": {
        "name": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "description": "Base64-encoded file content."
        },
        "mimeType": {
          "type": "string",
          "default": "application/octet-stream"
        },
        "description": {
          "type": ["string", "null"]
        },
        "relationship": {
          "type": "string",
          "default": "Alternative"
        }
      },
      "required": ["name", "content"],
      "additionalProperties": false
    }
  },
  "x-pdfUa": {
    "kind": "template",
    "templateVersion": 1,
    "renderEndpoint": "/render/template",
    "templateFields": ["version", "config", "fonts", "attachments", "rows"],
    "attachmentFields": ["name", "content", "mimeType", "description", "relationship"],
    "externalFontFields": ["src", "weight", "style"],
    "bundledFonts": [
      "Fira Code",
      "Inter",
      "JetBrains Mono",
      "Lato",
      "Liberation Mono",
      "Liberation Sans",
      "Liberation Serif",
      "Merriweather",
      "Montserrat",
      "Noto Sans",
      "Noto Sans Mono",
      "Noto Serif",
      "Nunito",
      "Open Sans",
      "Oswald",
      "Playfair Display",
      "Poppins",
      "Raleway",
      "Roboto",
      "Rubik"
    ],
    "blockOrder": ["text", "html", "heading", "image", "spacer", "divider"],
    "pageFormats": [
      {
        "name": "A3",
        "widthMm": 297,
        "heightMm": 420
      },
      {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      {
        "name": "A5",
        "widthMm": 148,
        "heightMm": 210
      },
      {
        "name": "A6",
        "widthMm": 105,
        "heightMm": 148
      },
      {
        "name": "Letter",
        "widthMm": 215.9,
        "heightMm": 279.4
      },
      {
        "name": "Legal",
        "widthMm": 215.9,
        "heightMm": 355.6
      },
      {
        "name": "Tabloid",
        "widthMm": 279.4,
        "heightMm": 431.8
      }
    ]
  }
}
