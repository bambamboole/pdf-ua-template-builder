{
  "name": "@bambamboole/pdf-ua-template-builder",
  "version": "0.4.2",
  "private": false,
  "description": "Embeddable React template builder for the pdf-ua-api PDF/UA renderer.",
  "author": "Manuel Christlieb",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./html-editor": {
      "types": "./dist/html-editor/index.d.ts",
      "import": "./dist/html-editor/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bambamboole/pdf-ua-template-builder.git"
  },
  "homepage": "https://github.com/bambamboole/pdf-ua-template-builder#readme",
  "bugs": {
    "url": "https://github.com/bambamboole/pdf-ua-template-builder/issues"
  },
  "keywords": [
    "pdf",
    "pdf-ua",
    "pdfua",
    "accessibility",
    "template",
    "builder",
    "react",
    "drag-and-drop",
    "wysiwyg"
  ],
  "scripts": {
    "dev": "docker compose up -d && node scripts/wait-for-api.mjs && vite",
    "build": "tsc --noEmit && vite build --mode lib",
    "build:app": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync:schema": "node scripts/sync-template-schema.mjs",
    "generate:types": "node scripts/generate-template-types.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:github": "oxlint --format=github",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/view": "^6.43.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.3",
    "@uiw/react-codemirror": "^4.25.10",
    "codemirror-json-schema": "^0.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  }
}
